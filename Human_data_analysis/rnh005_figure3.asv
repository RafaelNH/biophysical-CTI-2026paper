ax = subplot_tight(5, 6, 20);
imagesc(squeeze(RKi(:, end:-1:1, slice))', SSS3); axis image; axis off;
title('A11) $$K_{\mu}^\bot$$', 'Interpreter','latex', 'fontsize', fff)

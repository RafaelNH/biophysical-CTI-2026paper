ax = subplot_tight(5, 6, 19);
imagesc(squeeze(MKi(:, end:-1:1, slice))', SSS3); axis image; axis off;
title('A10) $$\overline{K}_{\mu}$$', 'Interpreter','latex', 'fontsize', fff)
